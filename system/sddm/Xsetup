#!/bin/sh
# hypr-setup Xsetup: runs as root before the login screen (SDDM, X11).
# Hybrid laptop: monitors wired to the NVIDIA card only show up at login if its outputs are
# attached to the main GPU ("reverse PRIME"). Then it turns on all monitors MIRRORED
# (same image on all: the password prompt shows on any screen). Only applies to the login screen;
# the session uses the layout from the control center → Displays. Installed by: install.sh sddm
command -v xrandr >/dev/null || exit 0

main=$(xrandr --listproviders | sed -n 's/^Provider 0: id: \(0x[0-9a-fA-F]*\).*/\1/p')
for p in $(xrandr --listproviders | sed -n 's/^Provider [1-9][0-9]*: id: \(0x[0-9a-fA-F]*\).*Sink Output.*/\1/p'); do
    xrandr --setprovideroutputsource "$p" "$main"
done
xrandr --auto

# Main screen: the laptop's (eDP/LVDS), otherwise the first connected one
outs=$(xrandr --query | awk '/ connected/ { if ($1 ~ /^(eDP|LVDS)/) print; else rest = rest $1 "\n" }
                             END { printf "%s", rest }' | awk '{ print $1 }')
main_out=$(echo "$outs" | head -1)
[ -n "$main_out" ] || exit 0
xrandr --output "$main_out" --auto --primary --pos 0x0
# Current mode of the main screen; the others copy it (if unsupported, they use their own)
mode=$(xrandr --query | awk -v o="$main_out" '$1 == o { f = 1; next } f && /^[^ ]/ { exit } f && /\*/ { print $1; exit }')
for o in $(echo "$outs" | tail -n +2); do
    xrandr --output "$o" --mode "$mode" --same-as "$main_out" 2>/dev/null ||
        xrandr --output "$o" --auto --same-as "$main_out"
done
exit 0
