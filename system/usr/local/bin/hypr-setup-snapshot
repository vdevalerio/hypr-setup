#!/usr/bin/env bash
# Before every pacman upgrade/removal (hook 00-hypr-setup-snapshot): saves the package list
# and a copy of /etc in /var/backups/hypr-setup/<date>/. Keeps the last 10.
# To undo: compare with `pacman -Qqe | diff - <folder>/pkglist.txt` and reinstall the old version
# with `sudo pacman -U /var/cache/pacman/pkg/<package>-<version>.pkg.tar.zst`.
set -u
DIR=/var/backups/hypr-setup
KEEP=10
dst="$DIR/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$dst" && chmod 700 "$DIR"
pacman -Q   > "$dst/versions.txt"           # all, with version (to roll back with pacman -U)
pacman -Qqen > "$dst/pkglist.txt"          # explicitly installed (repositories)
pacman -Qqem > "$dst/aur.txt"              # explicitly installed (AUR/foreign)
tar --zstd -cf "$dst/etc.tar.zst" -C / etc 2>/dev/null
ls -1d "$DIR"/*/ 2>/dev/null | head -n -"$KEEP" | xargs -r rm -rf
echo "hypr-setup: snapshot at $dst"
exit 0
