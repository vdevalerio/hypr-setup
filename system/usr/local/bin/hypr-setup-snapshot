#!/usr/bin/env bash
# Antes de cada atualização/remoção do pacman (hook 00-hypr-setup-snapshot): guarda a lista de
# pacotes e uma cópia do /etc em /var/backups/hypr-setup/<data>/. Mantém os 10 últimos.
# Para desfazer: compare com `pacman -Qqe | diff - <pasta>/pkglist.txt` e reinstale a versão antiga
# com `sudo pacman -U /var/cache/pacman/pkg/<pacote>-<versão>.pkg.tar.zst`.
set -u
DIR=/var/backups/hypr-setup
KEEP=10
dst="$DIR/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$dst" && chmod 700 "$DIR"
pacman -Q   > "$dst/versions.txt"           # todos, com versão (para voltar com pacman -U)
pacman -Qqen > "$dst/pkglist.txt"          # instalados explicitamente (repositórios)
pacman -Qqem > "$dst/aur.txt"              # instalados explicitamente (AUR/externos)
tar --zstd -cf "$dst/etc.tar.zst" -C / etc 2>/dev/null
ls -1d "$DIR"/*/ 2>/dev/null | head -n -"$KEEP" | xargs -r rm -rf
echo "hypr-setup: snapshot em $dst"
exit 0
