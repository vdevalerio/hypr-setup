#!/usr/bin/env bash
# Foliate with sentence-level read-aloud highlighting (it always highlights words,
# and the highlight froze after rate changes), reading that starts where the page is
# (not at the top of the chapter) and keyboard control of the read-aloud:
#   Ctrl+Space      play / pause          Ctrl+. / Ctrl+,          next / previous sentence
#   Ctrl+Backspace  stop                  Ctrl+Alt+. / Ctrl+Alt+,  next / previous paragraph
#   Ctrl+Return     read from the selected text (select it first; also works with the
#                   selection popover open, which has its own key controller)
# (Ctrl+arrows are eaten by the web view, hence the punctuation keys)
# Patches foliate-js and the viewer through GResource overlays: no root, nothing
# installed system-wide, rebuilt whenever the Foliate package or this script changes.
R=/usr/share/com.github.johnfactotum.Foliate/com.github.johnfactotum.Foliate.gresource
D=/com/github/johnfactotum/Foliate
C=${XDG_CACHE_HOME:-$HOME/.cache}/foliate-overlay

# overlay <resource path> <cache file> <sed args...>: extracts the resource, patches it, and
# adds it to G_RESOURCE_OVERLAYS (an empty or missing result is skipped, Foliate runs stock)
overlay() {
    local res=$1 out=$C/$2; shift 2
    if [ ! -s "$out" ] || [ "$R" -nt "$out" ] || [ "$0" -nt "$out" ]; then
        mkdir -p "$C"
        gresource extract "$R" "$D/$res" | sed "$@" > "$out.tmp" && mv "$out.tmp" "$out"
    fi
    [ -s "$out" ] && OVERLAYS+="${OVERLAYS:+:}$D/$res=$out"
}

OVERLAYS=
overlay foliate-js/view.js view.js \
    -e "s/initTTS(granularity = 'word')/initTTS(granularity = 'sentence')/" \
    -e "s|^        this.tts = new TTS(doc, textWalker, range =>|        this.tts = new TTS(doc, textWalker, (range, select = true) =>|" \
    -e "s|this.renderer.scrollToAnchor(range, true), granularity)|this.renderer.scrollToAnchor(range, select), granularity)\n        const t = this.tts, start = t.start.bind(t)\n        t.start = () => { const r = this.lastLocation?.range; return r ? t.from(r) : start() }|"

# tts.js: step(delta) = the sentence before/after the one being read (the paragraph before/after at
# the edges); setMark() paints the sentence and the word being spoken with the CSS Custom Highlight
# API instead of selecting the text. The sd_piper module sends "<sentence mark>#<n>" marks, n being
# the index of the whitespace-separated word inside the sentence.
mkdir -p "$C"
cat > "$C/tts-methods.js" <<'JS'
    step(delta) {
        const names = [...this.#ranges.keys()], i = names.indexOf(this.#lastMark) + delta
        if (i < 0) return this.prev()
        if (i >= names.length) return this.next()
        this.#lastMark = names[i]
        const [doc] = this.#list.current() ?? []
        return this.#speak(doc, ssml => this.#getMarkElement(ssml, this.#lastMark))
    }
    #words = []
    setMark(mark) {
        const [name, n] = mark.split('#')
        const range = this.#ranges.get(name)
        if (!range) return
        if (n === undefined || name !== this.#lastMark) {
            this.#lastMark = name
            this.highlight(range.cloneRange(), false)
            paintRange(range, 'tts-sentence')
            clearPaint('tts-word')
            this.#words = wordRanges(range)  // once per sentence, not once per word
        }
        // past the end (the reader split the text differently): the last word
        const word = n === undefined ? null : this.#words[Math.min(+n, this.#words.length - 1)]
        if (word) paintRange(word, 'tts-word')
    }
JS
cat > "$C/tts-helpers.js" <<'JS'

// highlights live in the window (section) that was painted: the one before is cleared when the
// reading moves to another, or its sentence and word stay painted there
const painted = {}
const clearPaint = key => {
    try { painted[key]?.CSS.highlights.delete(key) } catch (e) {}
    delete painted[key]
}

const paintRange = (range, key) => {
    const doc = range.startContainer.ownerDocument, win = doc.defaultView
    if (!win?.CSS?.highlights) return
    if (painted[key] !== win) clearPaint(key)
    if (!doc.getElementById('tts-highlight')) {
        const style = doc.createElement('style')
        style.id = 'tts-highlight'
        style.textContent = '::highlight(tts-sentence) { background-color: rgba(137, 180, 250, .30) }'
            + '::highlight(tts-word) { background-color: rgba(249, 226, 175, .85); color: #1e1e2e }'
        doc.head.append(style)
    }
    win.CSS.highlights.set(key, new win.Highlight(range.cloneRange()))
    painted[key] = win
}

// the whitespace-separated words of a range
const wordRanges = range => {
    const doc = range.startContainer.ownerDocument
    const root = range.commonAncestorContainer
    const nodes = []
    if (root.nodeType === Node.TEXT_NODE) nodes.push(root)
    else for (const w = doc.createTreeWalker(root, NodeFilter.SHOW_TEXT); w.nextNode();) nodes.push(w.currentNode)
    const parts = []
    let text = ''
    for (const node of nodes) {
        if (!range.intersectsNode(node)) continue
        const lo = node === range.startContainer ? range.startOffset : 0
        const hi = node === range.endContainer ? range.endOffset : node.length
        parts.push({ node, lo, at: text.length, len: hi - lo })
        text += node.data.slice(lo, hi)
    }
    const at = (pos, end) => {
        for (const p of parts)
            if (pos >= p.at && (end ? pos <= p.at + p.len : pos < p.at + p.len))
                return [p.node, p.lo + pos - p.at]
    }
    const words = []
    for (const m of text.matchAll(/\S+/g)) {
        const a = at(m.index), b = at(m.index + m[0].length, true)
        if (!a || !b) { words.push(null); continue }  // keeps the indexes
        const r = doc.createRange()
        r.setStart(...a)
        r.setEnd(...b)
        words.push(r)
    }
    return words
}
JS
# speech.js: the client keeps one pending event per message, so the events that arrive while the
# page is still handling a mark are dropped (the highlight then freezes on a word). A real queue
# instead; a backlog of marks is skipped to the latest one, other events are never dropped.
cat > "$C/ssip-iter.js" <<'JS'
    #makeIter(msgID) {
        const queue = []
        let wake
        this.#promises.set(msgID, { resolve: value => { queue.push(value); wake?.() } })
        return {
            next: async () => {
                while (!queue.length) await new Promise(r => (wake = r))
                while (queue.length > 1 && queue[0].mark && queue[1].mark) queue.shift()
                return queue.shift()
            },
            return: () => { this.#promises.delete(msgID) },
        }
    }
JS
overlay speech.js speech.js \
    -e '/^    #makeIter(msgID) {/,/^    }/{' \
    -e "/^    }/r $C/ssip-iter.js" \
    -e 'd' \
    -e '}'
overlay foliate-js/tts.js tts.js \
    -e '/^    setMark(mark) {/,/^    }/{' \
    -e "/^    }/r $C/tts-methods.js" \
    -e 'd' \
    -e '}' \
    -e "\$r $C/tts-helpers.js"
# the selected text, as the SSML to read from there (null without a selection)
overlay reader/reader.js reader.js \
    -e "s|^    printRange(doc, range) {|    async speakSelection() {\n        for (const { doc } of this.view.renderer.getContents()) {\n            const range = getSelectionRange(doc.getSelection())\n            if (!range) continue\n            await this.view.initTTS()\n            return this.view.tts.from(range)\n        }\n        return null\n    }\n&|"
overlay book-viewer.js book-viewer.js \
    -e "s|^    ttsSetMark(x) {.*|&\n    ttsStep(x) { return this.#exec('reader.view.tts.step', x) }\n    ttsSpeakSelection() { return this.#exec('reader.speakSelection') }|" \
    -e "s|^            const popover = new SelectionPopover()|&\n            popover.add_controller(utils.addShortcuts({\n                '<ctrl>Return': () => { popover.activate_action('selection.speak-from-here', null); popover.popdown(); return true },\n                '<ctrl>space': () => { popover.popdown(); this._navbar.tts_box.play(); return true },\n            }))|" \
    -e "s|^        this._view.webView.add_controller(utils.addShortcuts(shortcuts))|&\n        // the web view swallows Ctrl+Space: capture phase runs these first\n        const tts = this._navbar.tts_box, keys = {\n            '<ctrl>space': () => tts.play(),\n            '<ctrl>period': () => tts.speak(this._view.ttsStep(1)),\n            '<ctrl>comma': () => tts.speak(this._view.ttsStep(-1)),\n            '<ctrl><alt>period': () => tts.forward(),\n            '<ctrl><alt>comma': () => tts.backward(),\n            '<ctrl>BackSpace': () => tts.stop(),\n            '<ctrl>Return': () => this._view.ttsSpeakSelection().then(ssml => ssml ? tts.speak(ssml) : tts.start()),\n        }\n        // callbacks must return true or GTK keeps propagating (twice-run toggles, emoji picker)\n        for (const k in keys) { const f = keys[k]; keys[k] = () => (f(), true) }\n        for (const w of [this, this._view.webView]) {\n            const c = utils.addShortcuts(keys)\n            c.propagation_phase = Gtk.PropagationPhase.CAPTURE\n            w.add_controller(c)\n        }|"

[ -n "$OVERLAYS" ] && export G_RESOURCE_OVERLAYS="$OVERLAYS"
exec foliate "$@"
