/* Rofi — cores dinâmicas (colors.rasi vem do tema atual, theme.py) */
@import "colors.rasi"
@import "font.rasi"   /* tamanho: gerado por ~/.config/hypr/scripts/look.sh */

* {
    font:             @ui-font;
    background-color: transparent;
    text-color:       @text;
    margin:           0;
    padding:          0;
    spacing:          0;
}

/* Borda em gradiente (mesmas cores da borda das janelas): o rofi não faz gradiente na borda,
   então a janela tem fundo em gradiente + 2px de espaço, e o mainbox escuro fica por cima. */
window {
    width:            620px;
    location:         center;
    anchor:           center;
    padding:          2px;
    border:           0;
    border-radius:    16px;
    background-color: transparent;
    background-image: @accent-gradient;   /* definido em colors.rasi (theme.py) */
}

mainbox {
    padding:          16px;
    spacing:          12px;
    border-radius:    14px;
    background-color: @base-alpha;
    children:         [ inputbar, message, listview, mode-switcher ];
}

inputbar {
    padding:          10px 14px;
    spacing:          10px;
    border-radius:    12px;
    background-color: @surface0;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @mauve;
    font:       @ui-font-bold;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @overlay0;
    cursor:            text;
}

message {
    padding:          8px 12px;
    border-radius:    10px;
    background-color: @mantle;
}
textbox { text-color: @subtext0; }

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      4px;
    cursor:       pointer;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 10px;
    cursor:        pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element normal.urgent, element alternate.urgent { text-color: @red; }
element normal.active, element alternate.active { text-color: @blue; }
element selected.normal {
    background-color: @mauve;
    background-image: @accent-gradient;   /* igual ao workspace ativo da barra */
    text-color:       @crust;
}
element selected.urgent { background-color: @red;  text-color: @crust; }
element selected.active { background-color: @blue; text-color: @crust; }

element-icon {
    size:   28px;
    cursor: inherit;
}
element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    cursor:         inherit;
}

mode-switcher { spacing: 8px; }
button {
    padding:          8px;
    border-radius:    10px;
    background-color: @surface0;
    text-color:       @subtext0;
    cursor:           pointer;
}
button selected {
    background-color: @blue;
    text-color:       @crust;
}
