# fcitx5 — language switching is done by Hyprland (SUPER + CTRL + Space, keyboard.sh),
# so fcitx5's own shortcuts are set to keys that do not exist on ABNT2
# (Ctrl+Space stays free for Neovim; Shift alone switches nothing).
[Hotkey]
EnumerateWithTriggerKeys=False
EnumerateSkipFirst=False
ModifierOnlyKeyTimeout=250

[Hotkey/TriggerKeys]
0=Zenkaku_Hankaku

[Hotkey/AltTriggerKeys]
0=Hangul

[Hotkey/EnumerateForwardKeys]
0=Hangul_Hanja

[Hotkey/EnumerateBackwardKeys]
0=Hangul_Banja

[Hotkey/EnumerateGroupForwardKeys]
0=Hangul_Start

[Hotkey/EnumerateGroupBackwardKeys]
0=Hangul_End

[Hotkey/PrevPage]
0=Up

[Hotkey/NextPage]
0=Down

[Hotkey/PrevCandidate]
0=Shift+Tab

[Hotkey/NextCandidate]
0=Tab

[Behavior]
# Same input language in every app (the tray indicator applies everywhere)
ActiveByDefault=False
ShareInputState=All
PreeditEnabledByDefault=True
ShowInputMethodInformation=False
showInputMethodInformationWhenFocusIn=False
CompactInputMethodInformation=True
ShowFirstInputMethodInformation=False
DefaultPageSize=7
OverrideXkbOption=False
PreloadInputMethod=True
AllowInputMethodForPassword=False
ShowPreeditForPassword=False
AutoSavePeriod=30
