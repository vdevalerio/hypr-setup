// fastfetch — colors use ANSI names: they follow the terminal theme (theme.py → kitty).
// magenta = main theme accent, blue = the second.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": { "1": "magenta", "2": "blue" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[90m───────────────────────────────" },
    { "type": "os",       "key": "󰣇  os",       "format": "{pretty-name}" },
    { "type": "kernel",   "key": "󰻀  kernel" },
    { "type": "wm",       "key": "󰖯  wm",       "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "󰆍  term" },
    { "type": "packages", "key": "󰏖  pkgs",     "format": "{all}" },
    { "type": "uptime",   "key": "󰅐  uptime" },
    { "type": "memory",   "key": "󰍛  memory" },
    { "type": "battery",  "key": "󰁹  battery",  "format": "{capacity} {status}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
