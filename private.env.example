# Private settings for hypr-setup. Copy to private/private.env (git-ignored) and edit;
# ./install.sh deploys it to ~/.config/hypr-setup/private.env and `./install.sh save` copies it back.
# Plain bash syntax. Everything here is optional.

# Git identity (written to ~/.config/git/local, which the public git config includes)
GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"

# Extra folders for `backup` (the system ones, ~/.ssh, ~/.gnupg, keyrings... are always included)
BACKUP_EXTRA_PATHS=(~/Projects/work)
